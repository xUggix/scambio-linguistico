# Copia questo file in .env.local e inserisci i valori. .env.local non va mai committato.
# Le stesse variabili vanno impostate anche su Vercel (Project Settings → Environment Variables).

# --- Pubbliche (finiscono nel browser) ---
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# LiveKit Cloud → Settings → Project URL (wss://...)
NEXT_PUBLIC_LIVEKIT_URL=

# --- Segrete (solo server) ---
# Supabase → Project Settings → API Keys → secret key
SUPABASE_SECRET_KEY=
# LiveKit Cloud → Settings → API Keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Deepgram → API Keys
DEEPGRAM_API_KEY=
# Modello linguistico per i report (fornitore da scegliere al passo 6)
REPORT_LLM_API_KEY=
